---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TeachingGallery from "../components/TeachingGallery.astro";
import Layout from "../layouts/Layout.astro";
import HomeSection from "../components/HomeSection.astro";
import VocabullarySection from "../components/VocabullarySection.astro";
import LevelsSection from "../components/LevelsSection.astro";
import TeachersSection from "../components/TeachersSection.astro";
import AboutSection from "../components/AboutSection.astro";
import InformasiSection from "../components/InformasiSection.astro";
---

<Layout
  title="This Deutsch Academy | Kursus Bahasa Jerman"
  description="This Deutsch Academy adalah tempat belajar bahasa Jerman untuk level A1 hingga B2 dengan pendekatan yang terjangkau, terstruktur, dan mudah diakses."
>
  <Header />

  <main>
    <HomeSection />

    <VocabullarySection />

    <LevelsSection />

    <TeachersSection />

    <AboutSection />

    <InformasiSection />

    <TeachingGallery />
  </main>

  <Footer />

  <script>
    const navLinks = document.querySelectorAll(".nav-link");
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("main section[id]"),
    );

    const setActiveLink = (id: string): void => {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute("href") === `#${id}`;
        link.classList.toggle("is-active", isActive);
      });
    };

    let scrollFrame = 0;
    const updateActiveLink = (): void => {
      if (scrollFrame !== 0) return;

      scrollFrame = window.requestAnimationFrame(() => {
        scrollFrame = 0;
        const activationLine = window.innerHeight * 0.35;
        const activeSection = sections
          .filter(
            (section) => section.getBoundingClientRect().top <= activationLine,
          )
          .at(-1);

        if (activeSection) setActiveLink(activeSection.id);
      });
    };

    window.addEventListener("scroll", updateActiveLink, { passive: true });
    window.addEventListener("resize", updateActiveLink);
    updateActiveLink();
  </script>
</Layout>
