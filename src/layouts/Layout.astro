---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'This Deutsch Academy',
  description = 'This Deutsch Academy menyediakan kursus bahasa Jerman untuk level A1 hingga B2 dengan pendekatan yang terstruktur dan terjangkau.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
