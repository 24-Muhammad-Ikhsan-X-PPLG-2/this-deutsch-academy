---
import classroomInstruction from "../assets/teaching/classroom-instruction.jpg";
import interactiveClass from "../assets/teaching/interactive-class.jpg";
import learningTogether from "../assets/teaching/learning-together.jpg";
import groupPractice from "../assets/teaching/group-practice.jpg";

const slides = [
  {
    image: classroomInstruction,
    alt: "Pengajar menyampaikan materi di depan peserta kelas",
    caption: "Belajar bersama pengajar",
  },
  {
    image: interactiveClass,
    alt: "Suasana kelas dengan peserta mengikuti pembelajaran interaktif",
    caption: "Suasana pembelajaran",
  },
  {
    image: learningTogether,
    alt: "Peserta belajar bahasa bersama dalam kelompok",
    caption: "Diskusi di ruang kelas",
  },
  {
    image: groupPractice,
    alt: "Peserta berlatih dan berkolaborasi dalam kegiatan belajar",
    caption: "Latihan percakapan",
  },
];
---

<section
  id="dokumentasi-pengajaran"
  class="teaching-journal border-y border-[var(--color-border)] bg-[var(--color-ivory)]"
>
  <div class="container py-16 md:py-20">
    <header class="teaching-journal-heading">
      <div>
        <p class="section-label">Dokumentasi Pengajaran</p>
        <h2 class="serif-display">
          Belajar bahasa Jerman melalui pengalaman nyata.
        </h2>
      </div>
      <div class="teaching-journal-intro">
        <span class="teaching-journal-rule" aria-hidden="true"></span>
        <p>
          Intip suasana pembelajaran, interaksi bersama pengajar, dan berbagai
          aktivitas yang menjadi bagian dari perjalanan belajar bahasa Jerman.
        </p>
      </div>
    </header>

    <div
      class="teaching-gallery"
      data-teaching-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Galeri ilustrasi dokumentasi pengajaran"
      tabindex="0"
    >
      <div class="teaching-gallery-stage">
        {
          slides.map((slide, index) => (
            <figure
              class:list={[
                "teaching-gallery-slide",
                { "is-active": index === 0 },
              ]}
              data-teaching-slide
              data-slide-index={index}
                data-caption={slide.caption}
                role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} dari ${slides.length}`}
              aria-hidden={index === 0 ? "false" : "true"}
              inert={index === 0 ? undefined : true}
            >
              <img
                src={slide.image.src}
                alt={slide.alt}
                width={slide.image.width}
                height={slide.image.height}
                draggable="false"
                loading="eager"
                decoding="async"
              />
            </figure>
          ))
        }
        <span class="teaching-gallery-mark" aria-hidden="true">
          TDA <span>·</span> UNTUK BELAJAR
        </span>
      </div>

      <div class="teaching-gallery-rail">
        <p class="teaching-gallery-caption" data-teaching-caption aria-live="polite">
          {slides[0].caption}
        </p>
        <div class="teaching-gallery-navigation">
          <span
            class="teaching-gallery-count"
            data-teaching-count
            aria-live="polite"
          >
            <span data-teaching-current>01</span>
            <span class="teaching-gallery-separator" aria-hidden="true">/</span>
            04
          </span>
          <div class="teaching-gallery-indicators" aria-label="Pilih foto pengajaran">
            {
              slides.map((slide, index) => (
                <button
                  class="teaching-gallery-indicator"
                  type="button"
                  data-teaching-indicator
                  data-slide-index={index}
                  aria-label={`Tampilkan foto ${index + 1}: ${slide.caption}`}
                  aria-current={index === 0 ? "true" : undefined}
                />
              ))
            }
          </div>
          <button
            class="teaching-gallery-arrow"
            type="button"
            data-teaching-previous
            aria-label="Foto pengajaran sebelumnya"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 18 9 12l6-6" />
            </svg>
          </button>
          <button
            class="teaching-gallery-arrow"
            type="button"
            data-teaching-next
            aria-label="Foto pengajaran berikutnya"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>

      <p class="teaching-gallery-note">
        Foto ilustrasi, bukan dokumentasi asli This Deutsch Academy.
      </p>
    </div>
  </div>
</section>

<script>
  const galleries = document.querySelectorAll<HTMLElement>(
    "[data-teaching-carousel]",
  );

  galleries.forEach((gallery) => {
    const slides = Array.from(
      gallery.querySelectorAll<HTMLElement>("[data-teaching-slide]"),
    );
    const indicators = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-teaching-indicator]"),
    );
    const previousButton = gallery.querySelector<HTMLButtonElement>(
      "[data-teaching-previous]",
    );
    const nextButton = gallery.querySelector<HTMLButtonElement>(
      "[data-teaching-next]",
    );
    const count = gallery.querySelector<HTMLElement>("[data-teaching-count]");
    const currentNumber = gallery.querySelector<HTMLElement>(
      "[data-teaching-current]",
    );
    const caption = gallery.querySelector<HTMLElement>(
      "[data-teaching-caption]",
    );

    if (
      slides.length !== 4 ||
      indicators.length !== slides.length ||
      !previousButton ||
      !nextButton ||
      !count ||
      !currentNumber ||
      !caption
    ) {
      return;
    }

    let activeIndex = 0;
    let pointerStart: { x: number; y: number } | null = null;

    const updateSlide = (index: number): void => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
        slide.inert = !isActive;
      });

      indicators.forEach((indicator, indicatorIndex) => {
        if (indicatorIndex === activeIndex) {
          indicator.setAttribute("aria-current", "true");
        } else {
          indicator.removeAttribute("aria-current");
        }
      });

      const currentSlide = slides[activeIndex];
      currentNumber.textContent = String(activeIndex + 1).padStart(2, "0");
      caption.textContent = currentSlide.dataset.caption ?? "";
    };

    const moveBy = (step: number): void => {
      updateSlide(activeIndex + step);
    };

    previousButton.addEventListener("click", () => moveBy(-1));
    nextButton.addEventListener("click", () => moveBy(1));

    indicators.forEach((indicator) => {
      indicator.addEventListener("click", () => {
        const targetIndex = Number(indicator.dataset.slideIndex);
        if (Number.isInteger(targetIndex)) updateSlide(targetIndex);
      });
    });

    gallery.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        moveBy(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        moveBy(1);
      }
    });

    gallery.addEventListener("pointerdown", (event: PointerEvent) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      pointerStart = { x: event.clientX, y: event.clientY };
    });

    gallery.addEventListener("pointerup", (event: PointerEvent) => {
      if (pointerStart === null) return;
      const distanceX = event.clientX - pointerStart.x;
      const distanceY = event.clientY - pointerStart.y;
      pointerStart = null;

      if (
        Math.abs(distanceX) < 48 ||
        Math.abs(distanceX) < Math.abs(distanceY) * 1.25
      ) {
        return;
      }

      moveBy(distanceX < 0 ? 1 : -1);
    });

    gallery.addEventListener("pointercancel", () => {
      pointerStart = null;
    });
  });
</script>

<style>
  .teaching-journal-heading {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
  }

  .teaching-journal-heading h2 {
    max-width: 48rem;
    margin: 0.6rem 0 0;
    color: var(--color-charcoal);
    font-size: clamp(2.25rem, 5vw, 4.4rem);
    line-height: 0.98;
  }

  .teaching-journal-intro {
    display: flex;
    align-items: start;
    gap: 1rem;
    max-width: 34rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .teaching-journal-intro p {
    margin: 0;
  }

  .teaching-journal-rule {
    width: 2.5rem;
    height: 2px;
    flex: 0 0 auto;
    margin-top: 0.8rem;
    background: var(--color-gold);
  }

  .teaching-gallery {
    min-width: 0;
    outline: none;
  }

  .teaching-gallery-stage {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal);
    touch-action: pan-y;
    user-select: none;
  }

  .teaching-gallery-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 460ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .teaching-gallery-slide.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  .teaching-gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .teaching-gallery-mark {
    position: absolute;
    z-index: 2;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.55rem;
    background: var(--color-paper);
    color: var(--color-charcoal);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .teaching-gallery-mark span {
    color: var(--color-red);
  }

  .teaching-gallery-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-block: 1rem;
  }

  .teaching-gallery-caption {
    min-width: 0;
    margin: 0;
    color: var(--color-charcoal);
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.2;
  }

  .teaching-gallery-navigation {
    display: flex;
    align-items: center;
    gap: clamp(0.55rem, 1.4vw, 1.2rem);
    flex: 0 0 auto;
  }

  .teaching-gallery-count {
    color: var(--color-charcoal);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .teaching-gallery-separator {
    padding-inline: 0.2rem;
    color: var(--color-red);
  }

  .teaching-gallery-indicators {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .teaching-gallery-indicator {
    width: 1.25rem;
    height: 1.5rem;
    padding: 0.65rem 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .teaching-gallery-indicator::after {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-border);
    content: "";
    transition: background-color 180ms ease;
  }

  .teaching-gallery-indicator[aria-current="true"]::after {
    background: var(--color-red);
  }

  .teaching-gallery-arrow {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .teaching-gallery-arrow:hover {
    border-color: var(--color-charcoal);
    background: var(--color-charcoal);
    color: var(--color-white);
  }

  .teaching-gallery-arrow svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 1.5;
  }

  .teaching-gallery-note {
    margin: 0.65rem 0 0;
    color: var(--color-muted);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  .teaching-gallery:focus-visible,
  .teaching-gallery-arrow:focus-visible,
  .teaching-gallery-indicator:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .teaching-journal-heading {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 3rem;
    }

    .teaching-journal-intro {
      justify-self: end;
      padding-bottom: 0.3rem;
    }
  }

  @media (max-width: 540px) {
    .teaching-gallery-rail {
      align-items: start;
      flex-direction: column;
      gap: 0.8rem;
    }

    .teaching-gallery-navigation {
      width: 100%;
      justify-content: space-between;
    }

    .teaching-gallery-mark {
      top: 0.6rem;
      left: 0.6rem;
      font-size: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .teaching-gallery-slide,
    .teaching-gallery-indicator::after,
    .teaching-gallery-arrow {
      transition-duration: 1ms;
    }
  }
</style>
