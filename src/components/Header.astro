---
import logo from "../assets/logo.jpeg";

const navItems = [
  { label: "Beranda", href: "#home" },
  { label: "Level", href: "#levels" },
  { label: "Pengajar", href: "#teachers" },
  { label: "Tentang", href: "#about" },
  { label: "Seminar", href: "#seminar" },
  { label: "Pengajaran", href: "#dokumentasi-pengajaran" },
  { label: "Kontak", href: "#contact" },
];

const whatsappUrl = "https://wa.me/6282211071110";
const headerMessage =
  "Halo, saya ingin bertanya mengenai kursus bahasa Jerman di This Deutsch Academy.";
---

<header
  class="site-header border-b border-[var(--color-border)] bg-[var(--color-paper)]/95 backdrop-blur-sm sticky top-0 z-50"
>
  <div class="container flex items-center justify-between gap-4 py-4">
    <a
      href="#home"
      class="brand inline-flex items-center gap-3 text-[var(--color-charcoal)]"
      aria-label="This Deutsch Academy home"
    >
      <img class="brand-logo" src={logo.src} alt="This Deutsch Academy" />
      <span class="brand-copy flex" aria-hidden="true">
        <span class="brand-name">THIS DEUTSCH</span>
        <span class="brand-subtitle">ACADEMY</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navigasi utama">
      {
        navItems.map((item) => (
          <a
            class="nav-link text-[0.7rem] font-medium uppercase tracking-[0.15em] text-[var(--color-muted)] transition-colors duration-200"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`${whatsappUrl}?text=${encodeURIComponent(headerMessage)}`}
        target="_blank"
        rel="noreferrer"
        class="hidden rounded-none border border-[var(--color-red)] bg-[var(--color-red)] px-4 py-2 text-[0.7rem] font-medium uppercase tracking-[0.14em] text-[var(--color-white)] transition-colors duration-200 hover:border-[var(--color-charcoal)] hover:bg-[var(--color-charcoal)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-gold)] md:inline-flex"
      >
        WhatsApp
      </a>

      <button
        type="button"
        class="mobile-menu-button inline-flex h-10 w-10 items-center justify-center border border-[var(--color-border)] bg-transparent p-0 text-[var(--color-charcoal)] md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-line hamburger-line-top"></span>
          <span class="hamburger-line hamburger-line-middle"></span>
          <span class="hamburger-line hamburger-line-bottom"></span>
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="mobile-menu container"
    data-mobile-menu
    aria-label="Navigasi mobile"
    aria-hidden="true"
    inert
  >
    <div class="mobile-menu-inner">
      <ul class="mobile-menu-list">
        {
          navItems.map((item) => (
            <li class="mobile-menu-item">
              <a
                class="nav-link mobile-nav-link block text-sm font-medium uppercase tracking-[0.12em] text-[var(--color-charcoal)]"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  if (menuButton && mobileMenu) {
    let isMenuOpen = false;

    const setMenuOpen = (open: boolean): void => {
      isMenuOpen = open;
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.setAttribute(
        "aria-label",
        open ? "Tutup menu navigasi" : "Buka menu navigasi",
      );
      mobileMenu.classList.toggle("is-open", open);
      mobileMenu.setAttribute("aria-hidden", String(!open));
      mobileMenu.inert = !open;
    };

    menuButton.addEventListener("click", () => {
      setMenuOpen(!isMenuOpen);
    });

    mobileMenu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && isMenuOpen) {
        setMenuOpen(false);
        menuButton.focus();
      }
    });

    const desktopViewport = window.matchMedia("(min-width: 48rem)");
    desktopViewport.addEventListener("change", (event: MediaQueryListEvent) => {
      if (event.matches && isMenuOpen) {
        setMenuOpen(false);
      }
    });
  }
</script>
