---
import pricePoster from "../assets/posters/poster-1.jpeg";
import groupBenefitsPoster from "../assets/posters/poster-2.jpeg";
import courseBenefitsPoster from "../assets/posters/poster-3.jpeg";

const posters = [
  {
    src: pricePoster.src,
    title: "Daftar harga belajar bahasa Jerman",
    alt: "Poster daftar harga kelas privat dan grup untuk level A1, A2, dan B1",
  },
  {
    src: groupBenefitsPoster.src,
    title: "Alasan memilih format grup",
    alt: "Poster berisi empat alasan memilih format kelas grup",
  },
  {
    src: courseBenefitsPoster.src,
    title: "Fasilitas belajar",
    alt: "Poster fasilitas belajar seperti sertifikat, materi, komunitas, dan jadwal fleksibel",
  },
];
---

<section id="home" class="container py-12 md:py-20">
  <div class="hero-grid md:grid-cols-[1.1fr_0.9fr]">
    <div class="space-y-6 md:self-center">
      <p class="section-label">German learning · A1–B2</p>
      <h1
        class="serif-display max-w-xl text-5xl leading-[0.95] text-[var(--color-charcoal)] md:text-7xl"
      >
        Deutsch lernen. Neue Wege entdecken.
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-[var(--color-muted)]">
        Kursus bahasa Jerman yang terjangkau, terstruktur, dan siap membimbing
        Anda dari dasar hingga level menengah atas.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="#levels"
          class="inline-flex items-center border border-[var(--color-red)] bg-[var(--color-red)] px-5 py-3 text-[0.7rem] font-medium uppercase tracking-[0.15em] text-[var(--color-white)] transition-colors hover:border-[var(--color-charcoal)] hover:bg-[var(--color-charcoal)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-gold)]"
        >
          Jelajahi Level
        </a>
        <a
          href="https://wa.me/6282211071110?text=Halo%2C%20saya%20ingin%20konsultasi%20kursus%20bahasa%20Jerman."
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center border border-[var(--color-border)] bg-transparent px-5 py-3 text-[0.7rem] font-medium uppercase tracking-[0.15em] text-[var(--color-charcoal)] transition-colors hover:border-[var(--color-red)] hover:text-[var(--color-red)]"
        >
          Hubungi WhatsApp
        </a>
      </div>
    </div>

    <div
      class="poster-carousel"
      data-poster-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="This Deutsch Academy posters"
    >
      <div class="poster-stage">
        {
          posters.map((poster, index) => (
            <figure
              class:list={["poster-slide", index === 0 && "is-active"]}
              data-poster-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${posters.length}: ${poster.title}`}
              aria-hidden={index !== 0 ? "true" : undefined}
            >
              <img
                src={poster.src}
                alt={poster.alt}
                width="1280"
                height="1600"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </figure>
          ))
        }
      </div>

      <div class="poster-controls">
        <div class="poster-navigation">
          <button
            class="poster-arrow"
            type="button"
            data-poster-previous
            aria-label="Previous poster"
            disabled={posters.length < 2}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            class="poster-arrow"
            type="button"
            data-poster-next
            aria-label="Next poster"
            disabled={posters.length < 2}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </div>

        <div class="poster-pagination">
          <div class="poster-indicators" aria-label="Choose a poster">
            {
              posters.map((poster, index) => (
                <button
                  class:list={["poster-indicator", index === 0 && "is-active"]}
                  type="button"
                  data-poster-indicator={index}
                  aria-label={`Show poster ${index + 1}: ${poster.title}`}
                  aria-current={index === 0 ? "true" : undefined}
                />
              ))
            }
          </div>
          <p class="poster-count" data-poster-count aria-live="polite">
            01 / {String(posters.length).padStart(2, "0")}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-poster-carousel]")
    .forEach((carousel) => {
      const slides = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-poster-slide]"),
      );
      const indicators = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-poster-indicator]"),
      );
      const previousButton = carousel.querySelector<HTMLButtonElement>(
        "[data-poster-previous]",
      );
      const nextButton =
        carousel.querySelector<HTMLButtonElement>("[data-poster-next]");
      const count = carousel.querySelector<HTMLElement>("[data-poster-count]");

      if (!slides.length || !previousButton || !nextButton || !count) return;

      let activeIndex = 0;

      const showSlide = (index: number): void => {
        activeIndex = (index + slides.length) % slides.length;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;
          slide.classList.toggle("is-active", isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
        });

        indicators.forEach((indicator, indicatorIndex) => {
          const isActive = indicatorIndex === activeIndex;
          indicator.classList.toggle("is-active", isActive);
          if (isActive) {
            indicator.setAttribute("aria-current", "true");
          } else {
            indicator.removeAttribute("aria-current");
          }
        });

        count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      };

      previousButton.addEventListener("click", () =>
        showSlide(activeIndex - 1),
      );
      nextButton.addEventListener("click", () => showSlide(activeIndex + 1));

      indicators.forEach((indicator, index) => {
        indicator.addEventListener("click", () => showSlide(index));
      });

      carousel.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          showSlide(activeIndex - 1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          showSlide(activeIndex + 1);
        }
      });
    });
</script>

<style>
  .poster-carousel {
    min-width: 0;
    width: min(100%, 26rem);
    justify-self: center;
  }

  .poster-stage {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
    background: var(--color-paper);
    overflow: hidden;
  }

  .poster-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    margin: 0;
    opacity: 0;
    transform: translateX(0.35rem);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 220ms;
    visibility: hidden;
  }

  .poster-slide.is-active {
    opacity: 1;
    transform: translateX(0);
    visibility: visible;
  }

  .poster-slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .poster-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding-top: 1.15rem;
  }

  .poster-navigation,
  .poster-pagination,
  .poster-indicators {
    display: flex;
    align-items: center;
  }

  .poster-navigation {
    gap: 0.5rem;
  }

  .poster-arrow {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-charcoal);
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .poster-arrow:not(:disabled):hover {
    border-color: var(--color-red);
    color: var(--color-red);
  }

  .poster-arrow:disabled {
    color: var(--color-muted);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .poster-arrow svg {
    width: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 1.5;
  }

  .poster-pagination {
    gap: 1rem;
  }

  .poster-indicators {
    gap: 0.4rem;
  }

  .poster-indicator {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: 1px solid var(--color-muted);
    border-radius: 50%;
    background: transparent;
  }

  .poster-indicator.is-active {
    border-color: var(--color-red);
    background: var(--color-red);
  }

  .poster-count {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }

  .poster-arrow:focus-visible,
  .poster-indicator:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .poster-carousel {
      width: min(100%, 24rem);
      margin-inline: auto;
    }

    .poster-controls {
      padding-top: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-slide,
    .poster-arrow {
      transition: none;
    }
  }
</style>
