---
import SeminarGallery from "./SeminarGallery.astro";
---

<section
  id="informasi"
  class="border-y border-[var(--color-border)] bg-[var(--color-paper)]"
>
  <div class="container py-16 md:py-20">
    <div
      class="seminar-card grid gap-8 p-6 md:p-10 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-10"
    >
      <div>
        <p class="section-label">Seminar</p>
        <h2
          class="serif-display mb-4 text-4xl text-[var(--color-charcoal)] md:text-5xl"
        >
          Seminar bahasa Jerman untuk Anda yang ingin mulai dari langkah yang
          tepat.
        </h2>
        <p class="max-w-xl text-base leading-relaxed text-[var(--color-muted)]">
          Ikuti sesi konsultasi dan pemaparan singkat mengenai cara belajar yang
          efektif, pilihan level yang sesuai, serta strategi persiapan untuk
          kebutuhan studi dan pekerjaan.
        </p>
      </div>

      <SeminarGallery />
    </div>
  </div>
</section>
